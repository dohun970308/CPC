# ===== 대시보드 접속 비밀번호 (필수) =====
# 비워두면 누구나 대시보드를 볼 수 있습니다.
DASHBOARD_PASSWORD=

# ===== 네이버 검색광고 API =====
# 네이버 광고 > 도구 > API 사용 관리
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CUSTOMER_ID=

# ===== 구글 광고 API =====
# OAuth 클라이언트(Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보, 유형: 데스크톱 앱)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# 광고 계정 ID, 하이픈 없이 10자리 (예: 3237635395)
GOOGLE_ADS_CUSTOMER_ID=
# 관리자(MCC) 계정으로 접근할 때만. 하이픈 없이 10자리
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# 비워두면 v25
GOOGLE_ADS_API_VERSION=
# 개발자 토큰은 2026-09-09 지원 종료(선택, 서버에서 무시됨). 비워두세요.
GOOGLE_ADS_DEVELOPER_TOKEN=
